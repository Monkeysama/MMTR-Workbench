{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MMTR Workbench",
  "version": "0.4.0",
  "identifier": "local.mmtr.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MMTR Workbench",
        "width": 1440,
        "height": 940,
        "minWidth": 1060,
        "minHeight": 720,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/mmtr-core"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
